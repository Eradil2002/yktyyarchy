# Django settings
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-new-one
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-server-ip

# Database (PostgreSQL) — required for production
DB_ENGINE=django.db.backends.postgresql
DB_NAME=volunteering_db
DB_USER=postgres
DB_PASSWORD=your-strong-password-here
DB_HOST=db            # use 'db' inside Docker, 'localhost' outside
DB_PORT=5432

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@volunteers.kg

# Green API (WhatsApp OTP)
GREEN_API_INSTANCE_ID=your_instance_id_here
GREEN_API_TOKEN=your_api_token_here
GREEN_API_URL=https://api.green-api.com

# S3 Storage (set USE_S3=True to enable)
USE_S3=False
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=eu-central-1
# Optional (for S3-compatible providers, e.g. MinIO / Cloudflare R2)
AWS_S3_ENDPOINT_URL=
# Optional custom media domain (e.g. cdn.example.com)
AWS_S3_CUSTOM_DOMAIN=
# True for signed URLs, False for public-read buckets
AWS_QUERYSTRING_AUTH=False
